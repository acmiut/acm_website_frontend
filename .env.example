# Leave empty in development: requests go to /api on the Vite dev server, which proxies them to the backend.
# In production set it to the backend origin, e.g. https://api.example.com
# (that origin must allow this site in the backend's Cors:AllowedOrigins setting).
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api (the backend's https profile in launchSettings.json).
VITE_API_PROXY_TARGET=https://localhost:7030
